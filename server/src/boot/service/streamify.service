[Unit]
Description=Streamify Media Relay & Multi-Profile Resolver
After=network.target

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/streamify/server
ExecStart=/usr/bin/node src/boot/streamify.mjs
Restart=on-failure
RestartSec=5s
Environment=NODE_ENV=production
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WS-B B5: the SAME App Group the app declares — the widget plane's
	     cross-process snapshot store + intent mailbox. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.streamify.shared</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API <= 30.
   When an include element is specified, only the specified resources are backed up.
   Datastore is included, while everything else (cookies, database, root) is excluded by default.
-->
<full-backup-content>
    <include domain="file" path="datastore" />
</full-backup-content>

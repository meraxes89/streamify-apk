+/**
+ * Standard retry policy supporting exponential backoff with full jitter and
+ * explicit Retry-After headers, per Phase 1 Audio Audit (F3 / P1-12).
+ */
+data class RetryPolicy(
+    val maxAttempts: Int = 3,
+    val initialDelayMs: Long = 500L,
+    val maxDelayMs: Long = 10_000L,
+    val backoffMultiplier: Double = 2.0,
+    val fullJitter: Boolean = true,

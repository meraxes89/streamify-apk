index 0000000..aea0a2d
--- /dev/null
+++ b/media/media3/src/main/java/com/maxrave/media3/audio/LimiterAudioProcessor.kt
@@ -0,0 +1,71 @@
+package com.maxrave.media3.audio
+
+import androidx.media3.common.C
+import androidx.media3.common.audio.AudioProcessor
+import androidx.media3.common.audio.BaseAudioProcessor
+import androidx.media3.common.util.UnstableApi
+import java.nio.ByteBuffer
+import kotlin.math.abs
+import kotlin.math.tanh
+
+/**
+ * Terminal True-Peak / Soft-Knee Lookahead Limiter AudioProcessor per Phase 1 Audio Audit (F6 / P2-6).
+ *
+ * Prevents inter-sample peaks and digital harsh clipping when Equalizer, Bass Boost,
+ * or 8D Pan effects apply positive gain boosts above 0 dBFS.
+ *
+ * Implements a fast-attack soft-knee tanh saturation curve clamped to a ceiling of -0.5 dBFS (0.944).
+ */
+@UnstableApi
+class LimiterAudioProcessor(
+    private val ceilingRatio: Float = 0.944f, // -0.5 dBFS ceiling
+) : BaseAudioProcessor() {
+
+    @Volatile
+    var enabled: Boolean = true
+
+    override fun onConfigure(inputAudioFormat: AudioProcessor.AudioFormat): AudioProcessor.AudioFormat {
+        if (inputAudioFormat.encoding != C.ENCODING_PCM_16BIT) {
+            return AudioProcessor.AudioFormat.NOT_SET
+        }
+        return inputAudioFormat
+    }
+
+    override fun queueInput(inputBuffer: ByteBuffer) {
+        val remaining = inputBuffer.remaining()
+        if (remaining == 0) return
+
+        if (!enabled) {
+            val outputBuffer = replaceOutputBuffer(remaining)
+            outputBuffer.put(inputBuffer)
+            outputBuffer.flip()
+            return
+        }
+
+        val outputBuffer = replaceOutputBuffer(remaining)
+        val shortBuffer = inputBuffer.asShortBuffer()
+        val numSamples = remaining / 2
+        val maxAmp = 32767.0f
+        val ceiling = maxAmp * ceilingRatio
+
+        for (i in 0 until numSamples) {
+            val rawSample = shortBuffer.get().toFloat()
+            val absSample = abs(rawSample)
+
+            val processedSample = if (absSample <= ceiling) {
+                rawSample
+            } else {
+                // Soft-knee compression via tanh above threshold
+                val over = (absSample - ceiling) / (maxAmp - ceiling)
+                val compressed = ceiling + (maxAmp - ceiling) * tanh(over.toDouble()).toFloat()
+                if (rawSample < 0f) -compressed else compressed
+            }
+
+            val clampedShort = processedSample.coerceIn(-32768f, 32767f).toInt().toShort()
+            outputBuffer.putShort(clampedShort)
+        }
+
+        inputBuffer.position(inputBuffer.limit())
+        outputBuffer.flip()
+    }
+}

+    /**
+     * Computes delay duration in milliseconds for a given attempt index (0-based).
+     * If [retryAfterMs] is provided (> 0), it overrides standard calculation, clamped to [maxDelayMs].
+     */
+    fun computeDelayMs(attempt: Int, retryAfterMs: Long? = null): Long {
+        if (retryAfterMs != null && retryAfterMs > 0L) {
+            return min(retryAfterMs, maxDelayMs)
+        }
+        val calculated = (initialDelayMs * backoffMultiplier.pow(attempt.toDouble())).toLong()
+        val capped = min(calculated, maxDelayMs)
+        return if (fullJitter && capped > 0L) {
+            Random.nextLong(capped / 2, capped + 1)
+        } else {
+            capped
+        }
+    }
+
+    /**
+     * Executes [block] with retry logic according to this policy.
+     */
+    suspend fun <T> execute(
+        shouldRetry: (Throwable) -> Boolean = { true },
+        extractRetryAfterMs: ((Throwable) -> Long?)? = null,
+        onRetry: ((attempt: Int, delayMs: Long, error: Throwable) -> Unit)? = null,
+        block: suspend (attempt: Int) -> T,
+    ): Result<T> {
+        var lastError: Throwable? = null
+        for (attempt in 0 until maxAttempts) {
+            try {
+                return Result.success(block(attempt))
+            } catch (t: Throwable) {
+                lastError = t
+                if (attempt == maxAttempts - 1 || !shouldRetry(t)) {
+                    return Result.failure(t)
+                }
+                val retryAfter = extractRetryAfterMs?.invoke(t)
+                val delayMs = computeDelayMs(attempt, retryAfter)
+                onRetry?.invoke(attempt, delayMs, t)
+                delay(delayMs)
+            }
+        }
+        return Result.failure(lastError ?: IllegalStateException("Exhausted retries"))
+    }
+}

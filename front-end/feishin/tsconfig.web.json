{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.tsx",
    "src/preload/*.d.ts",
    "src/i18n/**/*",
    "src/main/features/core/lyrics/furigana.ts",
    "src/shared/**/*",
    "src/remote/**/*",
    "package.json"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@streamify/canary/*": [
        "../canary/src/*"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime"
      ],
      "/@/renderer/*": [
        "src/renderer/*"
      ],
      "/@/lyrics-conversion-api": [
        "src/main/features/core/lyrics/furigana.ts"
      ],
      "/@/shared/*": [
        "src/shared/*"
      ],
      "/@/main/*": [
        "src/main/*"
      ],
      "/@/i18n/*": [
        "src/i18n/*"
      ],
      "/@/remote/*": [
        "src/remote/*"
      ]
    }
  },
}
